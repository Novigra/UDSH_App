    <NodeBlock NodeID="c7a06691-5a66-45c0-ab7b-aff89dab18ad" NodeType="Dialogue" IsRoot="False" IsSubRoot="False" XPosition="878.0571428571427" YPosition="823.5714285714289" EngineXPosition="0" EngineYPosition="0">
