      <ParagraphLine TextType="Character">
        <SemiBold>
          <Normal>
            <Normal>MERCHANT</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
      <ParagraphLine TextType="Dialogue">
        <SemiBold>
          <Normal>
            <Normal>No problem. If you need anything, you know where to come.</Normal>
          </Normal>
        </SemiBold>
