    <NodeBlock NodeID="6bd8affd-609c-4d07-8291-c212390680ba" NodeType="Dialogue" IsRoot="False" IsSubRoot="False" XPosition="2037.7714285714283" YPosition="909.4" EngineXPosition="0" EngineYPosition="0">
