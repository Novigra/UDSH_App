      <NodeVisualProperties>
        <CollisionBorderInitialHeight>241.46666666666667</CollisionBorderInitialHeight>
        <IsChildrenNodeCollisionBorderActive>True</IsChildrenNodeCollisionBorderActive>
      </NodeVisualProperties>
      <ParagraphLine TextType="Character">
        <SemiBold>
          <Normal>
            <Normal>MERCHANT</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
      <ParagraphLine TextType="Dialogue">
        <SemiBold>
          <Normal>
            <Normal>Ladies and gentlemen, I can see your eyes glowing and taking interest, and they are not wrong. Swords, shields, potions— we got it all. Your hair receded and your head shines just as the day you came out of your mother's womb? no problem we got a solution for it.</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
    </NodeBlock>
    <NodeBlock NodeID="dbe3de1a-1607-4153-ab1e-83873527758e" NodeType="Choice" IsRoot="False" IsSubRoot="False" XPosition="877.1999999999999" YPosition="617.8571428571429" EngineXPosition="0" EngineYPosition="0" NodeOrder="1">
      <NodeChildrenConnections>
        <NodeID>c7a06691-5a66-45c0-ab7b-aff89dab18ad</NodeID>
      </NodeChildrenConnections>
      <NodeVisualProperties>
        <CollisionBorderInitialHeight>192.09333333333333</CollisionBorderInitialHeight>
        <IsChildrenNodeCollisionBorderActive>True</IsChildrenNodeCollisionBorderActive>
      </NodeVisualProperties>
      <ParagraphLine TextType="Choice">
        <SemiBold>
          <Normal>
            <Normal>Show me what you've got.</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
      <ParagraphLine TextType="Character">
        <SemiBold>
          <Normal>
            <Normal>PLAYER</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
      <ParagraphLine TextType="Dialogue">
        <SemiBold>
          <Normal>
            <Normal>Show me what you've got.</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
    </NodeBlock>
    <NodeBlock NodeID="078e117e-3663-451e-9a27-3eb55922b736" NodeType="Choice" IsRoot="False" IsSubRoot="False" XPosition="1265.485714285714" YPosition="619.5714285714286" EngineXPosition="0" EngineYPosition="0" NodeOrder="2">
      <NodeChildrenConnections>
        <NodeID>4febfbe5-a6aa-49ff-8714-827d8adb1287</NodeID>
      </NodeChildrenConnections>
      <NodeVisualProperties>
        <CollisionBorderInitialHeight>205.16</CollisionBorderInitialHeight>
        <IsChildrenNodeCollisionBorderActive>True</IsChildrenNodeCollisionBorderActive>
      </NodeVisualProperties>
      <ParagraphLine TextType="Choice">
        <SemiBold>
          <Normal>
            <Normal>I want to upgrade my sword.</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
      <ParagraphLine TextType="Character">
        <SemiBold>
          <Normal>
            <Normal>PLAYER</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
      <ParagraphLine TextType="Dialogue">
        <SemiBold>
          <Normal>
            <Normal>My sword is failing me. I want it stronger. Can you make it stronger?</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
    </NodeBlock>
    <NodeBlock NodeID="2a4da3b5-06db-41ad-aed4-629d2790eda8" NodeType="Choice" IsRoot="False" IsSubRoot="False" XPosition="1636.6285714285714" YPosition="585.8285714285714" EngineXPosition="0" EngineYPosition="0" NodeOrder="3">
      <NodeChildrenConnections />
      <NodeVisualProperties>
        <CollisionBorderInitialHeight>192.09333333333333</CollisionBorderInitialHeight>
        <IsChildrenNodeCollisionBorderActive>True</IsChildrenNodeCollisionBorderActive>
      </NodeVisualProperties>
      <ParagraphLine TextType="Choice">
        <SemiBold>
          <Normal>
            <Normal>I want to upgrade my shield.</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
      <ParagraphLine TextType="Character">
        <SemiBold>
          <Normal>
            <Normal>PLAYER</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
      <ParagraphLine TextType="Dialogue">
        <SemiBold>
          <Normal>
            <Normal>My shields need some fixing.</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
    </NodeBlock>
    <NodeBlock NodeID="d8b25206-ee93-4fe2-94b3-84f33f0b2203" NodeType="Choice" IsRoot="False" IsSubRoot="False" XPosition="2036.9142857142858" YPosition="616.1428571428571" EngineXPosition="0" EngineYPosition="0" NodeOrder="4">
