      <ParagraphLine TextType="Character">
        <SemiBold>
          <Normal>
            <Normal>MERCHANT</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
      <ParagraphLine TextType="Dialogue">
        <SemiBold>
          <Normal>
            <Normal>What're ya buyin?</Normal>
          </Normal>
        </SemiBold>
      </ParagraphLine>
    </NodeBlock>
    <NodeBlock NodeID="4febfbe5-a6aa-49ff-8714-827d8adb1287" NodeType="Dialogue" IsRoot="False" IsSubRoot="False" XPosition="1264.6285714285714" YPosition="782.1142857142856" EngineXPosition="0" EngineYPosition="0">
