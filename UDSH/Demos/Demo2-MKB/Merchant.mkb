    <NodeBlock NodeID="83c3df89-9727-432f-8617-f3c06d1358d9" NodeType="Dialogue" IsRoot="False" IsSubRoot="False" XPosition="1335.4285714285713" YPosition="310.4" EngineXPosition="0" EngineYPosition="0">
