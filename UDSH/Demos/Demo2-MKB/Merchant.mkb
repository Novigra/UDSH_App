  <Localization>
    <LocalizationData Culture="ar" IsRTL="True">
      <LocalizationBlock BlockID="83c3df89-9727-432f-8617-f3c06d1358d9">
        <ParagraphLine TextType="Character">
          <SemiBold>
            <Normal>
              <Normal>التاجر</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Dialogue">
          <SemiBold>
            <Normal>
              <Normal>سيداتي و سادتي، انا شايف عيونكم بتلمع و بتظهر اهتمام، و هم مش غلطانين. سيوف، دروع، جرعات، عندنا كل حاجة. شعرك اتسحب و راسك بتلمع زي اليوم اللي طلعت من بطن امك؟ مفيش مشكلة عندنا حل ليه.</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
      </LocalizationBlock>
      <LocalizationBlock BlockID="dbe3de1a-1607-4153-ab1e-83873527758e">
        <ParagraphLine TextType="Choice">
          <SemiBold>
            <Normal>
              <Normal>وريني عندك ايه</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Character">
          <SemiBold>
            <Normal>
              <Normal>اللاعب</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Dialogue">
          <SemiBold>
            <Normal>
              <Normal>وريني عندك ايه</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
      </LocalizationBlock>
      <LocalizationBlock BlockID="078e117e-3663-451e-9a27-3eb55922b736">
        <ParagraphLine TextType="Choice">
          <SemiBold>
            <Normal>
              <Normal>انا</Normal>
            </Normal>
          </SemiBold>
          <SemiBold>
            <Normal>
              <Normal> عايز احسن سيفي</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Character">
          <SemiBold>
            <Normal>
              <Normal>اللاعب</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Dialogue">
          <SemiBold>
            <Normal>
              <Normal>سيفي خذلني. انا عايزه اقوى. تقدر تخليه اقوى؟</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
      </LocalizationBlock>
      <LocalizationBlock BlockID="2a4da3b5-06db-41ad-aed4-629d2790eda8">
        <ParagraphLine TextType="Choice">
          <SemiBold>
            <Normal>
              <Normal>انا</Normal>
            </Normal>
          </SemiBold>
          <SemiBold>
            <Normal>
              <Normal> عايز احسن درعي</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Character">
          <SemiBold>
            <Normal>
              <Normal>اللاعب</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Dialogue">
          <SemiBold>
            <Normal>
              <Normal>درعي محتاج يتصلح</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
      </LocalizationBlock>
      <LocalizationBlock BlockID="d8b25206-ee93-4fe2-94b3-84f33f0b2203">
        <ParagraphLine TextType="Choice">
          <SemiBold>
            <Normal>
              <Normal>[خروج]</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Character">
          <SemiBold>
            <Normal>
              <Normal>اللاعب</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Dialogue">
          <SemiBold>
            <Normal>
              <Normal>شكرا على خدمتك</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
      </LocalizationBlock>
      <LocalizationBlock BlockID="c7a06691-5a66-45c0-ab7b-aff89dab18ad">
        <ParagraphLine TextType="Character">
          <SemiBold>
            <Normal>
              <Normal>التاجر</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Dialogue">
          <SemiBold>
            <Normal>
              <Normal>هتشتري ايه؟</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
      </LocalizationBlock>
      <LocalizationBlock BlockID="6c5ffa3a-7ca9-412a-86b7-7111b0101124">
        <ParagraphLine TextType="Character">
          <SemiBold>
            <Normal>
              <Normal>اللاعب</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Dialogue">
          <SemiBold>
            <Normal>
              <Normal>تمام؟</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
      </LocalizationBlock>
      <LocalizationBlock BlockID="4febfbe5-a6aa-49ff-8714-827d8adb1287">
        <ParagraphLine TextType="Character">
          <SemiBold>
            <Normal>
              <Normal>التاجر</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Dialogue">
          <SemiBold>
            <Normal>
              <Normal>ايوه احنا نقدر!</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
      </LocalizationBlock>
      <LocalizationBlock BlockID="6bd8affd-609c-4d07-8291-c212390680ba">
        <ParagraphLine TextType="Character">
          <SemiBold>
            <Normal>
              <Normal>التاجر</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
        <ParagraphLine TextType="Dialogue">
          <SemiBold>
            <Normal>
              <Normal>مفيش مشكلة. لو محتاج اي حاجة، انت عارف تلاقيني فين.</Normal>
            </Normal>
          </SemiBold>
        </ParagraphLine>
      </LocalizationBlock>
    </LocalizationData>
