    <FileID>42f76e00-5c1b-4f76-bbd3-fc8e1ba40c9e</FileID>
    <FileName>Laborer Letter Notes</FileName>
    <FileType>mkm</FileType>
    <FileAuthor>Keem</FileAuthor>
    <FileVersion>0.1.0</FileVersion>
